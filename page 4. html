
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Little Memories ❤️</title>
    <link rel="stylesheet" href="gallery.css">
</head>

<body>

<div class="gallery-container">

    <div class="top-label">
        ✦ A COLLECTION OF BEAUTIFUL MOMENTS ✦
    </div>

    <h1>Our Little Memories</h1>

    <p class="subtitle">
        Every picture holds a memory,<br>
        and every memory reminds me of you. ❤️
    </p>

    <!-- PHOTO GALLERY -->

    <div class="gallery">

        <div class="photo-card" onclick="openPhoto(this)">
            <img src="Messenger_creation_57BE469A-38BB-4318-B6ED-EA9ACB9E6107.jpeg" alt="Memory 1">
            <p>One Beautiful Moment ❤️</p>
        </div>

        <div class="photo-card" onclick="openPhoto(this)">
            <img src="WhatsApp Image 2026-11-24 at 11.05.56 AM.jpeg" alt="Memory 2">
            <p>A Moment to Remember ✨</p>
        </div>

        <div class="photo-card" onclick="openPhoto(this)">
            <img src="IMG-20260730-WA0020.jpg" alt="Memory 3">
            <p>My Favorite Smile 💗</p>
        </div>

        <div class="photo-card" onclick="openPhoto(this)">
            <img src="20260803_165019.jpg" alt="Memory 4">
            <p>Forever in My Heart 🌙</p>
        </div>

        <div class="photo-card" onclick="openPhoto(this)">
            <img src="20260803_170148.jpg" alt="Memory 5">
            <p>Our Sweetest Memories 💕</p>
        </div>

        <div class="photo-card" onclick="openPhoto(this)">
            <img src="20260810_155336.jpg" alt="Memory 6">
            <p>Always Special to Me ❤️</p>
        </div>

    </div>

    <p class="bottom-text">
        SOME MOMENTS BECOME MEMORIES. SOME MEMORIES BECOME FOREVER.
    </p>

    <button onclick="goNext()">MAKE A WISH ✨</button>

</div>

<!-- FULL SCREEN PHOTO VIEW -->

<div class="lightbox" id="lightbox" onclick="closePhoto()">
    <span class="close">&times;</span>
    <img id="lightboxImage" src="" alt="Selected memory">
</div>

<script src="gallery.js"></script>

</body>
</html>
